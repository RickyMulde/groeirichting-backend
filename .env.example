# --- GroeiCockpit / OpenClaw Gateway (attachment pipeline) ---
# Zie README-attachments.md voor de flow (Supabase → /v1/media → /v1/responses).

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

OPENCLAW_GATEWAY_URL=https://gateway.groeirichting.nl
OPENCLAW_GATEWAY_TOKEN=
# Optioneel: default agent komt uit conversatie-metadata
# OPENCLAW_AGENT_ID=main

# Timeout voor /v1/responses (ms)
OPENCLAW_TIMEOUT_MS=120000

# Rate limit en tools (optioneel)
# GROEI_COCKPIT_RATE_LIMIT_MAX=30
# GROEI_COCKPIT_TOOLS_ENABLED=false
# GROEI_COCKPIT_MAX_MESSAGE_LENGTH=6000
